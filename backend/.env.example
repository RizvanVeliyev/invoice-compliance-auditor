# Copy to .env and fill in ONE provider. NEVER commit .env.
# gemini | anthropic | openai | offline (no key; reads PDFs/text in the 'Field: value' layout only)
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional: USD per million tokens for your chosen model (check the provider's
# price page) -> enables per-invoice cost estimates in the UI and test report.
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=

# Optional: protect the audit desk. When set, auditors must enter this PIN;
# employees can still submit invoices without it.
AUDITOR_PIN=

# Optional: also push each alert to a chat channel (Slack / Microsoft Teams /
# Discord incoming-webhook URL). The message links to APP_PUBLIC_URL/audit?id=N.
ALERT_WEBHOOK_URL=
APP_PUBLIC_URL=http://localhost:3000

# Optional
ALLOWED_ORIGINS=http://localhost:3000
AUDIT_DB_PATH=data/audit.db
