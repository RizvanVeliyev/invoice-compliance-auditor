# Copy to .env. It works as it is; fill in what you need. NEVER commit .env.
# offline (no key; reads PDFs/text in the 'Field: value' layout only) | gemini | anthropic | openai
# For a real model, set its name here and fill in that provider's key below.
LLM_PROVIDER=offline

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional: USD per million tokens for your chosen model (check the provider's
# price page) -> enables per-invoice cost estimates in the UI and test report.
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=

# The single admin account, created on first start if Ledger has no admin yet.
# Without these, the sign-in page offers a one-time "Set up the admin" form instead.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional ready-made auditor account, created on first start if that email is not used yet.
AUDITOR_NAME=
AUDITOR_EMAIL=
AUDITOR_PASSWORD=

# Who becomes an auditor. open (default): a person who registers as an auditor is one at once.
# approval: they have employee access until the admin approves them on the Accounts page.
# Use approval when people outside the audit team can reach the sign-up page.
AUDITOR_SIGNUP=open

# Set to 1 when Ledger is served over https, so the session cookie is never sent over plain http.
COOKIE_SECURE=

# Optional: also push each alert to a chat channel (Slack / Microsoft Teams /
# Discord incoming-webhook URL). The message links to APP_PUBLIC_URL/audit?id=N.
ALERT_WEBHOOK_URL=
APP_PUBLIC_URL=http://localhost:3000

# Optional
ALLOWED_ORIGINS=http://localhost:3000
AUDIT_DB_PATH=data/audit.db
